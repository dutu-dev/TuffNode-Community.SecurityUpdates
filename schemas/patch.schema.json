{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dutu-dev/TuffNode-Community.SecurityUpdates/blob/main/schemas/patch.schema.json",
  "title": "TuffNode Community Security Patch Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patchId",
    "sequence",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "patchId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "path",
              "expectedCurrentSha256",
              "sha256",
              "sizeBytes"
            ],
            "properties": {
              "operation": {
                "const": "replace"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "expectedCurrentSha256": {
                "$ref": "#/$defs/hash"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52428800
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "path",
              "sha256",
              "sizeBytes"
            ],
            "properties": {
              "operation": {
                "const": "add"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 52428800
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "path",
              "expectedCurrentSha256"
            ],
            "properties": {
              "operation": {
                "const": "delete"
              },
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "expectedCurrentSha256": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*\\\\\\\\)(?!.*:)(?!.*(?:^|/)\\\\.\\\\.(?:/|$))(?!.*(?:^|/)\\\\.(?:/|$)).+$"
    }
  }
}
